[Unit]
Description=Job Scraper - daily run (all sources)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Edit these paths to match your installation
WorkingDirectory=/home/user/job_scraper
ExecStart=/home/user/.local/bin/uv run python -m scraper.cli daily
StandardOutput=append:/home/user/job_scraper/data/logs/systemd.log
StandardError=append:/home/user/job_scraper/data/logs/systemd.log
TimeoutStartSec=3600
User=user
Group=user

NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
