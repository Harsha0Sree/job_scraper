# =========================================================================
#  Crontab example — install with:  crontab crontab.example
#  1. Change PROJECT_DIR and MAILTO below (edit the value lines only;
#     cron does NOT support trailing comments on a line).
#  2. Exit codes: 0 = ok, 1 = nothing parsed, 3 = some sources failed,
#     4 = all sources failed.
#  3. NOTE: cron mails a job's OUTPUT (when it is not redirected), never a
#     bare exit code. Because every entry below redirects output to LOGFILE,
#     cron will NOT email you on failure. For failure alerts use the
#     webhook under `notifications:` in config.yaml, or systemd OnFailure=.
# =========================================================================

SHELL=/bin/bash
MAILTO=your-email@example.com
PROJECT_DIR=/home/user/job_scraper
LOGFILE=${PROJECT_DIR}/data/logs/cron.log

# Make sure uv is on PATH (if installed via the standalone installer)
PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin

# --- Daily scrape — runs every day at 09:00 ------------------------------
# Scrapes all sources, filters for 0-yrs-experience remote backend/AI roles,
# appends new matches to jobs_zero_experience.xlsx
0 9 * * * cd ${PROJECT_DIR} && uv run python -m scraper.cli daily >> ${LOGFILE} 2>&1

# --- Weekly range scrape — runs every Monday at 10:00 --------------------
# Backfills any jobs posted in the last 7 days that might have been missed
0 10 * * 1 cd ${PROJECT_DIR} && uv run python -m scraper.cli range --days 7 >> ${LOGFILE} 2>&1

# --- Monthly range scrape — runs on the 1st of each month at 11:00 -------
0 11 1 * * cd ${PROJECT_DIR} && uv run python -m scraper.cli range --days 30 >> ${LOGFILE} 2>&1

# --- Health-check — runs daily at 09:30 to verify state.json -------------
30 9 * * * cd ${PROJECT_DIR} && uv run python -m scraper.cli status >> ${LOGFILE} 2>&1
